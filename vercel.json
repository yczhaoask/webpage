{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.veteranpayguide.com"
        }
      ],
      "destination": "https://veteranpayguide.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vapayguide.vercel.app"
        }
      ],
      "destination": "https://veteranpayguide.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:page/index.html",
      "destination": "/:page/",
      "permanent": true
    }
  ]
}
